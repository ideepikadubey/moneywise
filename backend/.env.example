PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/billing_saas

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# OTP (optional - plug in provider like MSG91 / Twilio / SES later)
OTP_ENABLED=false

# CORS
CLIENT_URL=http://localhost:3000
